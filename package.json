{
  "name": "neox-ai",
  "version": "0.1.0",
  "description": "AI coding assistant CLI - turn natural language into real code files in any language",
  "type": "module",
  "bin": {
    "neox": "dist/cli/main.js"
  },
  "main": "dist/ide/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-renderer.mjs",
    "dev": "tsx cli/main.ts",
    "start": "node dist/cli/main.js",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "academy": "node academy/server/index.js",
    "academy:dev": "node --watch academy/server/index.js",
    "academy:install": "npm install --prefix academy"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "cli",
    "openai",
    "code-generation"
  ],
  "author": "Neox AI",
  "license": "MIT",
  "build": {
    "appId": "com.neoxai.ide",
    "productName": "Neox AI IDE",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/.env"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neox AI IDE",
      "artifactName": "Neox-AI-IDE-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Neox-AI-IDE-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^4.76.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "bootstrap-icons": "^1.13.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "electron@44.0.0": true
  }
}
